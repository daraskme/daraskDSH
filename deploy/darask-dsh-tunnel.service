[Unit]
Description=Cloudflare Tunnel for studio.darask.me
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/libexec/darask-dsh/cloudflared tunnel --no-autoupdate run --token-file %h/.config/ph3dmg/tunnel.token
Restart=on-failure
RestartSec=4

[Install]
WantedBy=default.target
