#!/usr/bin/env bash
set -euo pipefail
harness=$(dirname -- "$(readlink -f -- "$0")")
base=$(dirname -- "$harness")
if [[ ${1:-} == --profile && $# -ge 2 ]]; then shift; fi
if [[ ${1:-} == anima ]]; then
  anima_command=${2:---help}
  case "$anima_command" in
    -h|--help) echo '使い方: dsh anima {build|prepare|train --help}'; exit 0 ;;
    build|prepare|train) shift 2 ;;
    *) echo '使い方: dsh anima {build|prepare|train --help}' >&2; exit 2 ;;
  esac

  anima_build="$base/.runtime/anima-native"
  anima_binary="$anima_build/cargo/release/dsh-anima"
  export DSH_ANIMA_ROOT="$base"
  export DSH_ANIMA_RUNTIME="${DSH_ANIMA_RUNTIME:-$anima_build/libdsh_anima_runtime.so}"
  anima_python=${DSH_ANIMA_PYTHON:-"$base/.runtime/lora-venv/bin/python"}
  anima_require_python() {
    if ! command -v "$anima_python" >/dev/null; then
      echo 'Anima の Python が見つかりません。DSH_ANIMA_PYTHON に Python のパスを指定してください。' >&2
      exit 1
    fi
  }
  case "$anima_command" in
    build)
      anima_require_python
      exec "$anima_python" "$base/plugins/lora-training/native/build.py" --standalone "$@"
      ;;
    prepare)
      anima_require_python
      exec "$anima_python" "$base/plugins/lora-training/native/export_frontend.py" "$@"
      ;;
  esac

  anima_backend=native
  args=("$@")
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
      --backend) anima_backend=${args[i+1]:-} ;;
      --backend=*) anima_backend=${args[i]#*=} ;;
      --) break ;;
    esac
  done
  case "$anima_backend" in
    eager|compile)
      anima_require_python
      exec "$anima_python" "$base/plugins/lora-training/native/train.py" "$@"
      ;;
    native) ;;
    *) echo '--backend には native、eager、compile のいずれかを指定してください。' >&2; exit 2 ;;
  esac
  if [[ ! -x "$anima_binary" || ! -f "$DSH_ANIMA_RUNTIME" ]]; then
    anima_require_python
    "$anima_python" "$base/plugins/lora-training/native/build.py" --standalone
  fi
  exec "$anima_binary" "$@"
fi
node_bin=$(command -v node || true)
if [[ -z "$node_bin" ]] || ! "$node_bin" -e 'const [major,minor]=process.versions.node.split(".").map(Number); process.exit(Number(major < 24 || (major === 24 && minor < 9)))'; then
  node_bin=/usr/lib/chatgpt/resources/cua_node/bin/node
fi
if [[ ! -x "$node_bin" ]]; then echo 'Node.js >= 24.9 が必要です。' >&2; exit 1; fi
export PATH="$(dirname "$node_bin"):$PATH"
export DSH_HOME="${DSH_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/darask-dsh}"
cli="$harness/node_modules/@deepseek-ai/dsh/lib/bin.js"
case "${1:-web}" in
  workspace)
    if [[ ${2:-} != setup || $# -ne 2 ]]; then echo '使い方: dsh workspace setup' >&2; exit 2; fi
    exec "$node_bin" "$base/plugins/workspace-folders/setup.mjs"
    ;;
  login)
    if [[ ${2:-} == google ]]; then exec "$("$node_bin" "$harness/agents/locate.mjs" google)"; fi
    if [[ ${2:-} == devin ]]; then exec "$("$node_bin" "$harness/agents/locate.mjs" devin)" auth login; fi
    if [[ ${2:-} != claude ]]; then echo "使い方: dsh login <google|claude|devin>" >&2; exit 2; fi
    claude_bin=$("$node_bin" "$harness/agents/locate.mjs" claude)
    exec "$claude_bin" auth login --claudeai
    ;;
  ask)
    if [[ $# -lt 3 ]]; then echo 'dsh ask <CLI|openai> [--model ID] [--effort LEVEL] [--fast] [--ultracode] "依頼内容"' >&2; exit 2; fi
    case "$2" in auto|google|muse|grok|cursor|codex|claude|devin-free|devin|openai) export DARASK_DSH_MODEL="$2";; *) echo "未登録のエージェント: $2" >&2; exit 2;; esac
    shift 2
    while [[ $# -gt 1 ]]; do
      case "$1" in
        --model) export DARASK_OPT_MODEL="$2"; shift 2;;
        --effort) export DARASK_OPT_EFFORT="$2"; shift 2;;
        --fast) export DARASK_OPT_FAST=1; shift;;
        --ultracode) export DARASK_OPT_ULTRACODE=1; shift;;
        *) echo "未対応のオプション: $1" >&2; exit 2;;
      esac
    done
    if [[ $# -ne 1 ]]; then echo '依頼内容が必要です' >&2; exit 2; fi
    if [[ "$DARASK_DSH_MODEL" == openai ]]; then
      if [[ -z ${DARASK_OPT_MODEL:-} ]]; then echo 'OpenAI API のモデルを --model で指定してください' >&2; exit 2; fi
      if [[ -n ${DARASK_OPT_FAST:-}${DARASK_OPT_ULTRACODE:-} ]]; then echo 'dsh ask openai は --model と --effort に対応しています' >&2; exit 2; fi
    fi
    set -- headless "$1"
    ;;
  -h|--help)
    echo 'dsh web                         ブラウザーで起動'
    echo 'dsh ask <親エージェント> "依頼"   ターミナルで実行'
    echo 'dsh login claude                Claude Code の再ログイン'
    echo 'dsh login google                Google AI Ultra / Antigravity のログイン'
    echo 'dsh workspace setup             チャットの複数作業フォルダを有効化'
    echo 'dsh anima prepare --help        Anima の前処理モデルを書き出す'
    echo 'dsh anima train --help          Anima LoRA 学習の設定を表示'
    echo
    exec "$node_bin" "$cli" "$@"
    ;;
  -V|--version|plugin) exec "$node_bin" "$cli" "$@" ;;
esac
profile="${1:-web}"
if [[ $# -gt 0 ]]; then shift; fi
patches=()
case "$profile" in
  web) patches+=(--patch "$harness/config/web.yml");;
  headless|sdk|acp) patches+=(--patch "$harness/config/headless.yml");;
  *) exec "$node_bin" "$cli" "$profile" "$@";;
esac
exec "$node_bin" "$cli" "$profile" "${patches[@]}" --patch "$harness/config/agents.yml" \
  --patch "$harness/node_modules/@deepseek-ai/dsh-experimental-session-search/cordis.patch.yml" "$@"
